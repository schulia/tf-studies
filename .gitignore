# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable values (often contain secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform plan output
*.tfplan

# Terraform CLI config files
.terraformrc
terraform.rc

# Crash logs and override files
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Editor settings (local)
.vscode/
